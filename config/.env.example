# Copy to config/.env and fill in values. Never commit the real .env (it is gitignored).
# Compose picks this up via: docker compose --env-file config/.env ...
#
# Postgres runs as its OWN standalone Docker container (not inside docker-compose),
# publishing POSTGRES_PORT. The containerized backend reaches it via POSTGRES_HOST
# (default host.docker.internal). For `dotnet run` the backend instead reads
# appsettings.Development.json, which points at localhost:5432 — keep the two in sync.

# Standalone Postgres container connection
POSTGRES_HOST=host.docker.internal
POSTGRES_PORT=5432
POSTGRES_USER=fms
POSTGRES_PASSWORD=fms
POSTGRES_DB=fms

# Published backend port
BACKEND_PORT=8080

# Microsoft Entra (filled in during feature 02)
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=

# Comma-separated Microsoft Entra object IDs allowed to administer forms
ADMIN_USER_IDS=

# CORS origins allowed to call the backend (comma-separated); single Figma app dev origin
CORS_ALLOWED_ORIGINS=http://localhost:8443
