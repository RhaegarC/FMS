# Copy to config/.env and fill in values. Never commit the real .env (it is gitignored).
# Compose picks this up via: docker compose --env-file config/.env ...

# PostgreSQL
POSTGRES_USER=fms
POSTGRES_PASSWORD=fms
POSTGRES_DB=fms
POSTGRES_PORT=5432

# Published service ports
BACKEND_PORT=8080
ADMIN_PORT=4173
USER_PORT=4174

# Microsoft Entra (filled in during feature 02)
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=

# Comma-separated Microsoft Entra object IDs allowed to administer forms
ADMIN_USER_IDS=

# CORS origins allowed to call the backend (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:4173,http://localhost:4174
