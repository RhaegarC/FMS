# Entra ID settings for the admin portal (feature 04). Copy to .env and fill in.
# The app registration must list the dev redirect URI below (e.g. http://localhost:5173).
VITE_ENTRA_CLIENT_ID=
VITE_ENTRA_TENANT_ID=
# Optional: defaults to the current origin (window.location.origin).
VITE_ENTRA_REDIRECT_URI=
# Optional: defaults to <clientId>/.default (the API's audience in the backend config).
VITE_ENTRA_SCOPE=
