# Microsoft Entra ID sign-in for the single app. Copy to `src/web/.env` and fill
# in from your Entra app registration. The backend validates these bearer tokens
# against the SAME client id (`config/.env` ENTRA_CLIENT_ID), which doubles as the
# API audience, so the SPA registration and the backend share one app registration.
VITE_ENTRA_CLIENT_ID=
VITE_ENTRA_TENANT_ID=

# Optional overrides — sensible defaults apply when absent:
#   authority    → https://login.microsoftonline.com/<tenant-id>
#   redirectUri  → window.location.origin  (must be registered in Entra)
#   scopes       → <clientId>/.default  (the backend's audience)
#
# VITE_ENTRA_AUTHORITY=
# VITE_ENTRA_REDIRECT_URI=http://localhost:8443
# VITE_ENTRA_SCOPE=

# API base. Empty = same origin — the Vite dev server proxies /api to the backend
# (see server.proxy in vite.config.ts). Set to an absolute backend origin to
# bypass the proxy (that origin must then be in the backend's CORS allow-list).
# VITE_API_BASE=
